# ---------------------------------------------------------
# LINA-IA CONFIGURATION TEMPLATE
# Renomeie este arquivo para .env e preencha com seus dados
# ---------------------------------------------------------

# --- Embeddings e LlamaIndex ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DOCS_PATH="data/raw"
TB_DOCS_PATH="data/raw"
EMBEDDING_MODEL="models/embedding-001" # ou text-embedding-3-small se usar OpenAI

# --- Modelos LLM (OpenAI) ---
OPEN_API_KEY="sua_chave_openai_aqui"
OPEN_API_MODEL="gpt-4o-mini" # ex: gpt-3.5-turbo, gpt-4
OPEN_API_BASE_URL="https://api.openai.com"
OPEN_API_VERSION="v1"

# --- Qdrant (Vector Database) ---
QDRANT_HOST="localhost"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="" 
QDRANT_COLLECTION_NAME="lina_docs"
QDRANT_COLLECTION_TB="lina_docs_tb"

# --- Redis (Chat Memory) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USERNAME="default"
REDIS_PASSWORD="" 
REDIS_URL="redis://localhost:6379/0"
REDIS_COLLECTION_NAME="lina_chat_history"
